<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTituloCrearProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Producto"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <AutoCompleteTextView
            android:id="@+id/autoProductoExistente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seleccionar producto"
            android:inputType="none"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:cursorVisible="false"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etEditarSku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SKU"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etEditarNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del producto"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp" />
        <AutoCompleteTextView
            android:id="@+id/autoEditarCriticidadProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seleccionar criticidad"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:layout_marginBottom="16dp" />

        <AutoCompleteTextView
            android:id="@+id/autoEditarCategoriaProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seleccionar categoría"
            android:inputType="none"
            android:layout_marginBottom="16dp" />
        <EditText
            android:id="@+id/etEditarUnidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unidad"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etEditarStockMinimo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stock mínimo"
            android:inputType="number"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnGuardarProductoEditado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#6D55AC"
            android:textColor="#FFFFFF"
            android:text="Guardar cambios" />

    </LinearLayout>
</ScrollView>