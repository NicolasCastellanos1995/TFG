<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Operaciones"
        android:textAppearance="@style/TextAppearance.TFG.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="Registra movimientos y gestiona el catálogo"
        android:textAppearance="@style/TextAppearance.TFG.Subtitle" />
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntradas"
            style="@style/Widget.TFG.Tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            
            android:layout_margin="6dp"
            android:text="Entradas"
            app:icon="@drawable/ic_entrada"
            app:iconTint="@color/move_in" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalidas"
            style="@style/Widget.TFG.Tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            
            android:layout_margin="6dp"
            android:text="Salidas"
            app:icon="@drawable/ic_salida"
            app:iconTint="@color/move_out" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTransferencias"
            style="@style/Widget.TFG.Tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            
            android:layout_margin="6dp"
            android:text="Transferencias"
            app:icon="@drawable/ic_transfer"
            app:iconTint="@color/move_transfer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConsultasStock"
            style="@style/Widget.TFG.Tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            
            android:layout_margin="6dp"
            android:text="Consultar stock"
            app:icon="@drawable/ic_stock"
            app:iconTint="@color/brand" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistorial"
            style="@style/Widget.TFG.Tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            
            android:layout_margin="6dp"
            android:text="Historial"
            app:icon="@drawable/ic_historial"
            app:iconTint="@color/ink_2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlertas"
            style="@style/Widget.TFG.Tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            
            android:layout_margin="6dp"
            android:text="Alertas"
            app:icon="@drawable/ic_alerta"
            app:iconTint="@color/warn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrear"
            style="@style/Widget.TFG.Tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            
            android:layout_margin="6dp"
            android:text="Crear"
            app:icon="@drawable/ic_crear"
            app:iconTint="@color/brand" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditar"
            style="@style/Widget.TFG.Tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            
            android:layout_margin="6dp"
            android:text="Editar"
            app:icon="@drawable/ic_editar"
            app:iconTint="@color/brand" />

    </GridLayout>
</LinearLayout>
</ScrollView>
