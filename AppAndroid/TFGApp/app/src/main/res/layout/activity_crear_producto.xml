<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTituloCrearProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear Producto"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etSku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SKU"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del producto"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp" />
        <AutoCompleteTextView
            android:id="@+id/autoCriticidadProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seleccionar criticidad"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:layout_marginBottom="16dp" />

        <AutoCompleteTextView
            android:id="@+id/autoCategoriaProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seleccionar categoría"
            android:inputType="none"
            android:layout_marginBottom="16dp" />
        <EditText
            android:id="@+id/etUnidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unidad (ej: kg, unidad, caja)"
            android:inputType="text"
            android:layout_marginBottom="16dp" />
        <EditText
            android:id="@+id/etStockMinimo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Stock mínimo"
            android:inputType="number"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnGuardarProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#6D55AC"
            android:textColor="#FFFFFF"
            android:text="Guardar producto" />

    </LinearLayout>
</ScrollView>