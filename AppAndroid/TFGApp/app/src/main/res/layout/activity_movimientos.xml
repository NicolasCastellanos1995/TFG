<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FCF5FC"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="60dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/txtMovimientos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movimientos"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1A1025"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <Spinner
        android:id="@+id/spinnerOperario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp" />

    <ListView
        android:id="@+id/listMovimientosOperario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:divider="#6D55AC"
        android:dividerHeight="1dp"
        android:padding="8dp"
        android:layout_marginBottom="20dp" />

    <Spinner
        android:id="@+id/spinnerUbicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp" />

    <ListView
        android:id="@+id/listMovimientosUbicacion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:divider="#6D55AC"
        android:dividerHeight="1dp"
        android:padding="8dp" />

</LinearLayout>