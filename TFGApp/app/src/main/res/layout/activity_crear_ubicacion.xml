<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTituloCrearUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear Ubicación"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etCodigoUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Código"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etCriticidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Criticidad"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etCoordX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Coordenada X"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etCoordY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Coordenada Y"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etCoordZ"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Coordenada Z"
            android:inputType="numberDecimal"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnGuardarUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar ubicación" />

    </LinearLayout>
</ScrollView>