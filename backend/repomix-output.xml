<file path="src/main/resources/static/css/dashboard.css">
@import url("theme.css");

.container { display: flex; min-height: 100vh; }

/* ---------- Menú lateral ---------- */
.sidebar {
    width: 232px;
    flex-shrink: 0;
    background: var(--ink);
    padding: 28px 16px;
}
.logo {
    margin: 0 0 32px 12px;
    font-size: 1.25rem;
    font-weight: 600;
    color: #fff;
}
.sidebar ul { list-style: none; margin: 0; padding: 0; }
.sidebar a {
    display: block;
    padding: 11px 14px;
    border-left: 3px solid transparent;
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    color: #BDB6D3;
    text-decoration: none;
    font-weight: 500;
    transition: background .15s, color .15s;
}
.sidebar a:hover { background: rgba(255, 255, 255, .06); color: #fff; }
.sidebar a.active { background: rgba(255, 255, 255, .1); border-left-color: #A894E0; color: #fff; }

/* ---------- Contenido ---------- */
.main-content { flex: 1; min-width: 0; padding: 32px 36px; }

.topbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 28px; }
.topbar h1 { margin: 0; font-size: 1.75rem; font-weight: 600; }
.topbar p { margin: 4px 0 0; color: var(--muted); }

.logout-btn {
    padding: 10px 18px;
    font: inherit;
    font-weight: 500;
    color: var(--ink-2);
    background: transparent;
    border: 1px solid #CFC9DE;
    border-radius: var(--r-md);
    cursor: pointer;
    transition: background .15s, border-color .15s;
}
.logout-btn:hover { background: var(--brand-tint); border-color: var(--brand); color: var(--brand-dark); }

/* ---------- Indicadores ---------- */
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; margin-bottom: 28px; }

.card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 20px 22px;
    box-shadow: var(--shadow);
}
.card span { font-size: .92rem; font-weight: 500; color: var(--muted); }
.card h3 {
    margin: 6px 0 0;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 2.4rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--ink);
}
.card.warning { background: var(--warn-tint); border-color: #EBD3A4; }
.card.warning h3, .card.warning span { color: var(--warn); }
.card.danger  { background: var(--out-tint);  border-color: #EDBDBD; }
.card.danger h3,  .card.danger span  { color: var(--out); }

/* ---------- Paneles y tablas ---------- */
.panel {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 22px 24px;
    margin-bottom: 24px;
    box-shadow: var(--shadow);
}
.panel h2 { margin: 0 0 16px; font-size: 1.1rem; font-weight: 600; }

table { width: 100%; border-collapse: collapse; }
th {
    padding: 10px 14px;
    text-align: left;
    font-size: .85rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--paper);
    border-bottom: 1px solid var(--line);
}
td { padding: 13px 14px; border-bottom: 1px solid var(--line); color: var(--ink); }
tbody tr:last-child td { border-bottom: 0; }
tbody tr:hover { background: #FAF9FD; }
.panel tbody td:nth-child(n+3) { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: .92rem; }
td.empty, .empty { text-align: center; color: var(--muted); font-family: var(--font); padding: 24px; }

/* ---------- Movimientos ---------- */
.movements { display: flex; flex-direction: column; gap: 10px; }

.movement-item {
    display: grid;
    grid-template-columns: 150px 1.2fr 1.2fr 1fr 150px;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 4px solid var(--brand);
    border-radius: var(--r-md);
}
.movement-item:has(.type.in)       { border-left-color: var(--in); }
.movement-item:has(.type.out)      { border-left-color: var(--out); }
.movement-item:has(.type.transfer) { border-left-color: var(--transfer); }
.movement-item:has(.type.adjust)   { border-left-color: var(--warn); }

.movement-item span { color: var(--ink-2); }
.movement-item b { color: var(--ink); font-weight: 600; }
.movement-item small { color: var(--muted); font-family: var(--mono); font-size: .8rem; }

.type { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: .85rem; font-weight: 600; }
.type.in       { background: var(--in-tint);       color: #1F6B48; }
.type.out      { background: var(--out-tint);      color: #8E2323; }
.type.transfer { background: var(--transfer-tint); color: #2A528C; }
.type.adjust   { background: var(--warn-tint);     color: #7A4900; }

@media (max-width: 900px) {
    .container { flex-direction: column; }
    .sidebar { width: 100%; padding: 16px; }
    .logo { margin-bottom: 12px; }
    .main-content { padding: 20px 16px; }
    .movement-item { grid-template-columns: 1fr; gap: 6px; }
    .panel { overflow-x: auto; }
}
</file>

