<file path="src/main/resources/static/css/admin.css">
@import url("theme.css");

body { min-height: 100vh; }

.admin-wrapper { max-width: 1150px; margin: 0 auto; }
.admin-title { margin-bottom: .25rem; font-size: 1.75rem; font-weight: 600; color: var(--ink); }
.admin-subtitle { color: var(--muted); font-size: .95rem; }
.section-title { font-size: 1.15rem; font-weight: 600; color: var(--ink); }

.admin-card {
    background: var(--card);
    border: 1px solid var(--line) !important;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow) !important;
}

/* Campos */
.form-control {
    font-family: var(--font);
    color: var(--ink);
    background: #fff;
    border: 1px solid #CFC9DE;
    border-radius: var(--r-md);
}
.form-control::placeholder { color: #9A94AE; }
.form-control:focus {
    color: var(--ink);
    background: #fff;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(109, 85, 172, .22);
}

/* Botones (variables de Bootstrap 5.3) */
.btn-primary, .btn-create {
    --bs-btn-color: #fff;
    --bs-btn-bg: var(--brand);
    --bs-btn-border-color: var(--brand);
    --bs-btn-hover-color: #fff;
    --bs-btn-hover-bg: var(--brand-dark);
    --bs-btn-hover-border-color: var(--brand-dark);
    --bs-btn-active-bg: var(--brand-dark);
    --bs-btn-active-border-color: var(--brand-dark);
    font-weight: 600;
    border-radius: var(--r-md);
    padding: .65rem 1.1rem;
}
.btn-outline-primary {
    --bs-btn-color: var(--brand);
    --bs-btn-border-color: var(--brand);
    --bs-btn-hover-bg: var(--brand);
    --bs-btn-hover-border-color: var(--brand);
    --bs-btn-hover-color: #fff;
    --bs-btn-active-bg: var(--brand-dark);
    --bs-btn-active-border-color: var(--brand-dark);
    border-radius: var(--r-md);
}
.btn-outline-warning {
    --bs-btn-color: var(--warn);
    --bs-btn-border-color: #D9A85A;
    --bs-btn-hover-bg: var(--warn);
    --bs-btn-hover-border-color: var(--warn);
    --bs-btn-hover-color: #fff;
    --bs-btn-active-bg: var(--warn);
    --bs-btn-active-border-color: var(--warn);
}
.btn-outline-danger {
    --bs-btn-color: var(--out);
    --bs-btn-border-color: #E3A5A5;
    --bs-btn-hover-bg: var(--out);
    --bs-btn-hover-border-color: var(--out);
    --bs-btn-hover-color: #fff;
    --bs-btn-active-bg: var(--out);
    --bs-btn-active-border-color: var(--out);
}
.btn-sm { border-radius: var(--r-sm); }

/* Tabla */
.custom-table { --bs-table-hover-bg: #FAF9FD; }
.custom-table thead th {
    font-size: .85rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--paper);
    border-bottom: 1px solid var(--line);
}
.custom-table td { color: var(--ink); border-color: var(--line); }
.custom-table td:first-child { font-family: var(--mono); color: var(--muted); }
.empty-message { color: var(--muted); padding: 24px !important; }
.role-text { font-weight: 500; text-transform: capitalize; }

/* Estado */
.badge.bg-success   { background: var(--in-tint) !important; color: #1F6B48; font-weight: 600; }
.badge.bg-secondary { background: #ECE9F3 !important;        color: var(--muted); font-weight: 600; }

/* Botón de cerrar sesión (usa btn-primary en la plantilla) */
.logout-btn {
    --bs-btn-color: var(--ink-2);
    --bs-btn-bg: transparent;
    --bs-btn-border-color: #CFC9DE;
    --bs-btn-hover-color: var(--brand-dark);
    --bs-btn-hover-bg: var(--brand-tint);
    --bs-btn-hover-border-color: var(--brand);
