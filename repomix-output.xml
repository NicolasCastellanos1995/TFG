            th:text="${modoEdicion} ? 'Editar usuario' : 'Crear nuevo usuario'">
        </h3>

        <form th:action="${modoEdicion} ? @{/admin/users/update} : @{/admin/users/save}"
              th:object="${user}"
              method="post">

            <input type="hidden" th:field="*{id}">

            <!-- USERNAME -->
            <div class="mb-3">
                <label class="form-label">Nombre de usuario</label>
