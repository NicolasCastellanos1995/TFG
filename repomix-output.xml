<file path="backend/database/migrations/20261014_align_id_columns_bigint.sql">
-- Apply once to an existing database created from the original 01-schema.sql.
-- This preserves row data while aligning SERIAL/INTEGER identifiers with JPA Long.
BEGIN;

ALTER TABLE products DROP CONSTRAINT products_category_id_fkey;
ALTER TABLE stock
    DROP CONSTRAINT stock_location_id_fkey,
    DROP CONSTRAINT stock_product_id_fkey;
ALTER TABLE inventory_movements
    DROP CONSTRAINT inventory_movements_created_by_fkey,
    DROP CONSTRAINT inventory_movements_cancelled_by_fkey;
ALTER TABLE inventory_movement_lines
    DROP CONSTRAINT inventory_movement_lines_movement_id_fkey,
    DROP CONSTRAINT inventory_movement_lines_product_id_fkey,
    DROP CONSTRAINT inventory_movement_lines_from_location_id_fkey,
    DROP CONSTRAINT inventory_movement_lines_to_location_id_fkey;

ALTER TABLE users ALTER COLUMN id TYPE BIGINT;
ALTER TABLE categories ALTER COLUMN id TYPE BIGINT;
ALTER TABLE locations ALTER COLUMN id TYPE BIGINT;
ALTER TABLE products
    ALTER COLUMN id TYPE BIGINT,
    ALTER COLUMN category_id TYPE BIGINT;
ALTER TABLE stock
    ALTER COLUMN id TYPE BIGINT,
    ALTER COLUMN location_id TYPE BIGINT,
    ALTER COLUMN product_id TYPE BIGINT;
ALTER TABLE inventory_movements
    ALTER COLUMN id TYPE BIGINT,
    ALTER COLUMN created_by TYPE BIGINT,
    ALTER COLUMN cancelled_by TYPE BIGINT;
ALTER TABLE inventory_movement_lines
    ALTER COLUMN id TYPE BIGINT,
    ALTER COLUMN movement_id TYPE BIGINT,
    ALTER COLUMN product_id TYPE BIGINT,
    ALTER COLUMN from_location_id TYPE BIGINT,
    ALTER COLUMN to_location_id TYPE BIGINT;

ALTER SEQUENCE users_id_seq AS BIGINT;
ALTER SEQUENCE categories_id_seq AS BIGINT;
ALTER SEQUENCE locations_id_seq AS BIGINT;
ALTER SEQUENCE products_id_seq AS BIGINT;
ALTER SEQUENCE stock_id_seq AS BIGINT;
ALTER SEQUENCE inventory_movements_id_seq AS BIGINT;
ALTER SEQUENCE inventory_movement_lines_id_seq AS BIGINT;

ALTER TABLE products
    ADD CONSTRAINT products_category_id_fkey
    FOREIGN KEY (category_id) REFERENCES categories(id);
ALTER TABLE stock
    ADD CONSTRAINT stock_location_id_fkey
        FOREIGN KEY (location_id) REFERENCES locations(id),
    ADD CONSTRAINT stock_product_id_fkey
        FOREIGN KEY (product_id) REFERENCES products(id);
ALTER TABLE inventory_movements
    ADD CONSTRAINT inventory_movements_created_by_fkey
        FOREIGN KEY (created_by) REFERENCES users(id),
    ADD CONSTRAINT inventory_movements_cancelled_by_fkey
        FOREIGN KEY (cancelled_by) REFERENCES users(id);
ALTER TABLE inventory_movement_lines
    ADD CONSTRAINT inventory_movement_lines_movement_id_fkey
        FOREIGN KEY (movement_id) REFERENCES inventory_movements(id),
    ADD CONSTRAINT inventory_movement_lines_product_id_fkey
        FOREIGN KEY (product_id) REFERENCES products(id),
    ADD CONSTRAINT inventory_movement_lines_from_location_id_fkey
        FOREIGN KEY (from_location_id) REFERENCES locations(id),
    ADD CONSTRAINT inventory_movement_lines_to_location_id_fkey
        FOREIGN KEY (to_location_id) REFERENCES locations(id);

COMMIT;
</file>

<file path="backend/Dockerfile.lambda">
FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /build
COPY pom.xml ./
RUN mvn -B -DskipTests dependency:go-offline
COPY src ./src
RUN mvn -B -DskipTests package

FROM public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 AS adapter
FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=adapter /lambda-adapter /opt/extensions/lambda-adapter
COPY --from=build /build/target/*.jar /app/app.jar
ENV PORT=8080 AWS_LWA_PORT=8080 AWS_LWA_READINESS_CHECK_PATH=/ \
    AWS_LWA_READINESS_CHECK_PROTOCOL=http JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70"
EXPOSE 8080
CMD ["java", "-jar", "/app/app.jar"]
</file>

<file path="backend/scripts/start.ps1">
$ErrorActionPreference = 'Stop'
Set-Location (Join-Path $PSScriptRoot '..')
Get-Content .env | ForEach-Object { if ($_ -match '^([A-Za-z_][A-Za-z0-9_]*)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2].Trim('"'), 'Process') } }
$target = $env:DB_TARGET.Trim().ToLowerInvariant()
if ($target -eq 'docker') {
  $name = if ($env:DB_NAME) { $env:DB_NAME } else { 'tfg_db' }
  $env:SELECTED_DB_URL = "jdbc:postgresql://postgres:5432/$name"
  $env:SELECTED_DB_USER = $env:DB_USER; $env:SELECTED_DB_PASSWORD = $env:DB_PASSWORD
  docker compose --profile docker-db up -d postgres
} elseif ($target -eq 'neon') {
  $env:SELECTED_DB_URL = $env:NEON_DB_JDBC_URL; $env:SELECTED_DB_USER = $env:NEON_DB_USERNAME; $env:SELECTED_DB_PASSWORD = $env:NEON_DB_PASSWORD
} else { throw 'DB_TARGET debe ser docker o neon' }
docker compose up -d --build backend
</file>

<file path="backend/scripts/start.sh">
#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
set -a; source ./.env; set +a
target=$(printf '%s' "${DB_TARGET:-docker}" | tr '[:upper:]' '[:lower:]')
case "$target" in
 docker) export SELECTED_DB_URL="jdbc:postgresql://postgres:5432/${DB_NAME:-tfg_db}" SELECTED_DB_USER="$DB_USER" SELECTED_DB_PASSWORD="$DB_PASSWORD"; docker compose --profile docker-db up -d postgres; docker compose up -d --build backend;;
 neon) export SELECTED_DB_URL="$NEON_DB_JDBC_URL" SELECTED_DB_USER="$NEON_DB_USERNAME" SELECTED_DB_PASSWORD="$NEON_DB_PASSWORD"; docker compose up -d --build backend;;
 *) echo 'DB_TARGET debe ser docker o neon' >&2; exit 1;;
esac
</file>

<file path="INSTRUCCIONES_CORRECCIONES.md">
# Entrega reconstruida desde Repomix

**Aviso:** este ZIP reconstruye solo los archivos de texto presentes en el XML; NO contiene binarios originales (APK, imágenes, JAR, DOCX, PPTX). No se ha podido compilar ni ejecutar contra una base de datos real en esta revisión. No contiene el `.env` real.

## Arranque
1. Copia `backend/.env.example` a `backend/.env`. Genera `JWT_SECRET` aleatorio de al menos 32 bytes y pon credenciales nuevas.
2. Cambia `DB_TARGET=docker` o `DB_TARGET=neon`. Neon requiere URL JDBC con `sslmode=require`.
3. En Linux/macOS: `cd backend && bash scripts/start.sh`; en Windows PowerShell: `cd backend; ./scripts/start.ps1`.
4. Web local: `http://localhost:8080`. Android emulador: `http://10.0.2.2:8080/`.
5. Para un teléfono físico local, cambia `APP_BIND=0.0.0.0` y configura `http://IP_LAN_DEL_PC:8080/` en Android DEBUG **solo en red de confianza**. Para producción, usa HTTPS y compila Android release.
6. Si usas Docker y Neon, no hace falta arrancar PostgreSQL local. Si vuelves a Docker, el script arranca el servicio postgres.

## Cambios
- Selección de PostgreSQL desde `.env` a través de scripts de inicio.
- Alineadas las variables JDBC de Compose y Spring.
- Cookie secure parametrizada para desarrollo HTTP; usar `SESSION_COOKIE_SECURE=true` bajo HTTPS.
- Login rechaza cuentas inactivas y mensajes de credenciales uniformes.
- Autorización por rol supervisor en escrituras del catálogo.
- Borrado de usuarios vía POST con protección CSRF de Spring Security.
- Android sin logs de cuerpos y sin cleartext en release; backup deshabilitado.
- Docker Lambda actualizado a Java 25.

## Límites y comprobaciones pendientes
